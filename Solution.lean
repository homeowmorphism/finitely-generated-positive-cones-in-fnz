module

public import FnZPositiveCones.Main

@[expose] public section

/-!
# Palomar proofs: finitely generated positive cones in Fₙ × ℤ

The definitions and theorem types below match `Challenge.lean`. Their proofs
use the existing formalization of Theorem 1.1 and Corollary 1.2 of Hang Lu Su,
*Finitely generated positive cones in Fₙ × ℤ* (arXiv:2608.31103v1).
-/

namespace Palomar

universe u

/-- A strict positive cone for a left order on a group: it is a subsemigroup
excluding the identity, and every nonidentity element or its inverse belongs to it. -/
def IsPositiveCone {G : Type u} [Group G] (P : Subsemigroup G) : Prop :=
  (1 : G) ∉ P ∧ ∀ g : G, g = 1 ∨ g ∈ P ∨ g⁻¹ ∈ P

/-- A group has a positive cone generated by a finite set under nonempty products.
`Subsemigroup.closure` expresses semigroup generation. -/
def HasFGPositiveCone (G : Type u) [Group G] : Prop :=
  ∃ S : Finset G, IsPositiveCone (Subsemigroup.closure (S : Set G))

/-- Su, Theorem 1.1: Fₙ × ℤ has a finitely generated strict positive cone
for every even integer n ≥ 2. -/
theorem evenRank_hasFGPositiveCone :
    ∀ n : ℕ, 2 ≤ n → Even n →
      HasFGPositiveCone (FreeGroup (Fin n) × Multiplicative ℤ) :=
  FnZPositiveCones.evenRank_hasFGPositiveCone

/-- Su, Corollary 1.2: for n ≥ 2, Fₙ × ℤ has a finitely generated strict
positive cone exactly when n is even. -/
theorem hasFGPositiveCone_iff_even :
    ∀ n : ℕ, 2 ≤ n →
      (HasFGPositiveCone (FreeGroup (Fin n) × Multiplicative ℤ) ↔ Even n) :=
  FnZPositiveCones.hasFGPositiveCone_iff_even

end Palomar
