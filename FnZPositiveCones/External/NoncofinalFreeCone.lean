module

public import FnZPositiveCones.External.NoncofinalFreeSubgroup
public import FnZPositiveCones.Cone.Topology

@[expose] public section

/-!
# Nonabelian free groups have no finitely generated strict positive cone

We specialize the prefix argument of Hermiller–Šunić, arXiv:1609.06288,
Section 2 (Lemma 3 and the proof of Theorem 1), to a semigroup generated by a
finite set. No automata theorem is needed: the suffixes of those generators
form the finite set of possible completions used in their argument.
-/

namespace FnZPositiveCones
namespace NoncofinalFreeCone

open FreeGroup NoncofinalFreeSubgroup
universe u
variable {ι : Type u}

/-- Reading a word visits precisely products of its prefixes; only the forward
implication is needed for finite suffix completion. -/
theorem vertex_factorization (w : List (ι × Bool)) (q : FreeGroup ι)
    (hq : q ∈ vertices (MonoidHom.id _) w) :
    ∃ a b : List (ι × Bool), w = a ++ b ∧ mk a = q := by
  induction w generalizing q with
  | nil =>
    have hq' : q = 1 := hq
    exact ⟨[], [], rfl, hq'.symm⟩
  | cons s w ih =>
    rcases hq with hq | ⟨r, hr, rfl⟩
    · have hq' : q = 1 := hq
      exact ⟨[], s :: w, rfl, hq'.symm⟩
    · obtain ⟨a, b, hab, ha⟩ := ih r hr
      refine ⟨s :: a, b, by simp [hab], ?_⟩
      change mk (s :: a) = mk [s] * r
      rw [← ha, mul_mk]
      rfl

/-- The finite set of group elements represented by suffixes of a fixed word. -/
def suffixes (w : List (ι × Bool)) : Set (FreeGroup ι) :=
  mk '' {t | t ∈ w.tails}

theorem suffixes_finite (w : List (ι × Bool)) : (suffixes w).Finite :=
  w.tails.finite_toSet.image mk

/-- A visited prefix can be completed to the whole word by one of its suffixes. -/
theorem vertex_suffix (w : List (ι × Bool)) (q : FreeGroup ι)
    (hq : q ∈ vertices (MonoidHom.id _) w) :
    ∃ r ∈ suffixes w, q * r = mk w := by
  obtain ⟨a, b, hw, ha⟩ := vertex_factorization w q hq
  refine ⟨mk b, ⟨b, (List.mem_tails _ _).mpr ⟨a, hw.symm⟩, rfl⟩, ?_⟩
  rw [← ha, mul_mk, hw]

/-- Positive words whose reduced-word prefixes have completions from `T` are
closed under multiplication: reduction deletes vertices, and a prefix in the
second factor can be completed after multiplying by the first positive factor. -/
def completable [DecidableEq ι] (P : Subsemigroup (FreeGroup ι))
    (T : Set (FreeGroup ι)) : Subsemigroup (FreeGroup ι) where
  carrier := {g | g ∈ P ∧ ∀ q ∈ vertices (MonoidHom.id _) g.toWord,
    ∃ r ∈ T, q * r ∈ P}
  mul_mem' := by
    rintro g h ⟨hg, hgT⟩ ⟨hh, hhT⟩
    refine ⟨P.mul_mem hg hh, ?_⟩
    intro q hq
    rw [toWord_mul] at hq
    have hq' := vertices_reduce_subset (MonoidHom.id _) _ hq
    rw [vertices_append, mk_toWord] at hq'
    rcases hq' with hq' | ⟨r, hr, rfl⟩
    · exact hgT q hq'
    · obtain ⟨s, hs, hpos⟩ := hhT r hr
      refine ⟨s, hs, ?_⟩
      change (g * r) * s ∈ P
      rw [mul_assoc]
      exact P.mul_mem hg hpos

/-- Finite positive generation bounds the set of suffixes needed to complete
any vertex of a reduced positive word. -/
theorem exists_finite_completions [DecidableEq ι] (P : Subsemigroup (FreeGroup ι))
    (hfg : SemigroupFG P) :
    ∃ T : Set (FreeGroup ι), T.Finite ∧
      ∀ g ∈ P, ∀ q ∈ vertices (MonoidHom.id _) g.toWord, ∃ r ∈ T, q * r ∈ P := by
  obtain ⟨S, hS⟩ := hfg
  let T : Set (FreeGroup ι) := ⋃ g ∈ (S : Set (FreeGroup ι)), suffixes g.toWord
  have hfin : T.Finite := S.finite_toSet.biUnion (fun g _ => suffixes_finite g.toWord)
  have hle : P ≤ completable P T := by
    nth_rw 1 [← hS]
    apply Subsemigroup.closure_le.mpr
    intro g hg
    have hgP : g ∈ P := by rw [← hS]; exact Subsemigroup.subset_closure hg
    refine ⟨hgP, ?_⟩
    intro q hq
    obtain ⟨r, hr, hqr⟩ := vertex_suffix g.toWord q hq
    refine ⟨r, Set.mem_iUnion.mpr ⟨g, Set.mem_iUnion.mpr ⟨hg, hr⟩⟩, ?_⟩
    rwa [hqr, mk_toWord]
  exact ⟨T, hfin, fun g hg => (hle hg).2⟩

/-- Every group element is visited by a reduced positive word. A reduced
conjugate and its inverse both visit the prescribed element, and one is positive. -/
theorem exists_positive_vertex [Nontrivial ι] [DecidableEq ι]
    (P : Subsemigroup (FreeGroup ι)) (hP : IsPositiveCone P) (g : FreeGroup ι) :
    ∃ h ∈ P, g ∈ vertices (MonoidHom.id _) h.toWord := by
  let i : ι := Classical.choice (inferInstance : Nonempty ι)
  obtain ⟨s, hs⟩ := exists_reduced_conjugate_prefix g.toWord [(i, true)]
    isReduced_toWord IsReduced.singleton (by simp)
  let w := g.toWord ++ [s] ++ [(i, true)] ++ invRev [s] ++ invRev g.toWord
  have hw : IsReduced w := hs
  have hwne : mk w ≠ (1 : FreeGroup ι) := by
    intro he
    have hword := congrArg toWord he
    rw [toWord_mk, hw.reduce_eq, toWord_one] at hword
    have := congrArg List.length hword
    simp [w, invRev_length] at this
  have hg : g ∈ vertices (MonoidHom.id _) w := by
    dsimp [w]
    rw [List.append_assoc, List.append_assoc, List.append_assoc, vertices_append]
    left
    simpa only [mk_toWord, MonoidHom.id_apply] using
      endpoint_mem_vertices (MonoidHom.id _) g.toWord
  have hginv : g ∈ vertices (MonoidHom.id _) (invRev w) := by
    dsimp [w]
    simp only [invRev_append, invRev_invRev]
    rw [vertices_append]
    left
    simpa only [mk_toWord, MonoidHom.id_apply] using
      endpoint_mem_vertices (MonoidHom.id _) g.toWord
  rcases (hP.2 (mk w)).resolve_left hwne with hpos | hneg
  · refine ⟨mk w, hpos, ?_⟩
    simpa only [toWord_mk, hw.reduce_eq] using hg
  · refine ⟨(mk w)⁻¹, hneg, ?_⟩
    simpa only [toWord_inv, toWord_mk, hw.reduce_eq] using hginv

/-- The strict positive cone of a free group on at least two generators cannot
be generated by finitely many nonempty positive products. -/
theorem not_semigroupFG [Nontrivial ι] (P : Subsemigroup (FreeGroup ι))
    (hP : IsPositiveCone P) : ¬ SemigroupFG P := by
  classical
  intro hfg
  obtain ⟨T, hT, hcomplete⟩ := exists_finite_completions P hfg
  let O := coneLeftOrder (⟨P, hP⟩ : PositiveCone (FreeGroup ι))
  let := O.order
  obtain ⟨b, hb⟩ := hT.bddAbove
  obtain ⟨g, hg, hq⟩ := exists_positive_vertex P hP b⁻¹
  obtain ⟨r, hr, hpos⟩ := hcomplete g hg b⁻¹ hq
  have hbr : b < r := hpos
  exact (not_lt_of_ge (hb hr)) hbr

/-- The endpoint form used when the bounded subgroup projects trivially. -/
theorem not_hasFGPositiveCone [Nontrivial ι] : ¬ HasFGPositiveCone (FreeGroup ι) := by
  rintro ⟨S, hS⟩
  exact not_semigroupFG _ hS ⟨S, rfl⟩

/-- In particular, every rank `n ≥ 2`, including rank two, is excluded. -/
theorem finite_rank_not_hasFGPositiveCone {n : ℕ} (hn : 2 ≤ n) :
    ¬ HasFGPositiveCone (FreeGroup (Fin n)) := by
  have : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr hn
  exact not_hasFGPositiveCone

end NoncofinalFreeCone
end FnZPositiveCones
